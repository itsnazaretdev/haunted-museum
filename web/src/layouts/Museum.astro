---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A haunted museum of dead tech, powered by a local open model." } =
  Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,700;6..12,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header container">
      <a href="/" class="logo">👻 Haunted Museum <span class="mono">of Dead Tech</span></a>
      <nav aria-label="Museum wings">
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Exhibits</a>
        <a href="/debate" aria-current={path.startsWith("/debate") ? "page" : undefined}>Debate Hall</a>
        <a href="/graveyard" aria-current={path.startsWith("/graveyard") ? "page" : undefined}>Graveyard</a>
      </nav>
      <div class="spirits">
        <span class="spirit-status" data-spirit-status>Calling the spirits…</span>
        <label class="medium" data-medium hidden>
          <span class="sr-only">Model that channels the ghosts</span>
          <select data-medium-select></select>
        </label>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="container site-footer">
      Every ghost here runs on a local open model. No internet needed to talk to the dead.
    </footer>

    <script>
      import { getJson, getModel, setModel } from "../lib/api";

      type Health = { online: boolean; modelReady: boolean; model: string; models: string[] };

      const status = document.querySelector<HTMLElement>("[data-spirit-status]")!;
      const medium = document.querySelector<HTMLElement>("[data-medium]")!;
      const select = document.querySelector<HTMLSelectElement>("[data-medium-select]")!;

      function showStatus(state: "awake" | "asleep", text: string) {
        status.dataset.state = state;
        status.textContent = text;
      }

      async function checkSpirits() {
        let health: Health;
        try {
          health = await getJson<Health>("/api/health");
        } catch {
          showStatus("asleep", "Museum server is closed");
          return;
        }

        if (!health.online) return showStatus("asleep", "Spirits asleep · start Ollama");
        if (!health.modelReady) return showStatus("asleep", "No models yet · ollama pull gemma3:4b");

        // The saved model was uninstalled: forget it and use the server's choice.
        if (getModel() && !health.models.includes(getModel())) setModel("");

        if (health.models.length > 1) {
          // Several models installed: the visitor can choose the medium.
          showStatus("awake", "Spirits awake ·");
          select.innerHTML = health.models
            .map((m) => `<option value="${m}" ${m === health.model ? "selected" : ""}>${m}</option>`)
            .join("");
          medium.hidden = false;
        } else {
          showStatus("awake", `Spirits awake · ${health.model}`);
          medium.hidden = true;
        }
      }

      // Changing the medium reloads the page so every ghost starts fresh with the new model.
      select.addEventListener("change", () => {
        setModel(select.value);
        location.reload();
      });

      checkSpirits();
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 24px;
  }

  .logo {
    font-weight: 800;
    text-decoration: none;
    font-size: 1.05rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  nav a {
    padding: 6px 12px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--muted);
    transition: color 0.2s ease, background 0.2s ease;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    color: var(--text);
    background: var(--surface-2);
  }

  .spirits {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .medium[hidden] {
    display: none;
  }

  .medium select {
    font: inherit;
    font-size: 0.85rem;
    font-family: var(--font-code);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 10px;
    cursor: pointer;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .logo .mono {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .site-footer {
    padding-block: 48px 32px;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }
</style>