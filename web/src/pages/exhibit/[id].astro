---
import { getCollection, render } from "astro:content";
import Museum from "../../layouts/Museum.astro";
import Ghost from "../../components/Ghost.astro";
import Seance from "../../components/Seance.astro";
import Offering from "../../components/Offering.astro";
import Guestbook from "../../components/Guestbook.astro";

export async function getStaticPaths() {
  const exhibits = await getCollection("exhibits");
  return exhibits.map((exhibit) => ({ params: { id: exhibit.id }, props: { exhibit } }));
}

const { exhibit } = Astro.props;
const { data } = exhibit;
const { Content } = await render(exhibit);
---

<Museum title={`${data.name} · Haunted Museum`} description={data.epitaph}>
  <div class="container exhibit" style={`--ghost: ${data.color}`}>
    <a class="back" href="/">← Back to the halls</a>

    <!-- Story on the left, séance on the right. The séance stays at the top (no sticky). -->
    <div class="top">
      <article class="plaque">
        <div class="portrait" data-portrait>
          <Ghost color={data.color} shape={data.shape} size={110} />
        </div>
        <p class="eyebrow">Exhibit · {data.born} — {data.died}</p>
        <h1>{data.name}</h1>
        <p class="epitaph">“{data.epitaph}”</p>

        <details class="critics">
          <summary>What the critics say</summary>
          <ul>{data.critics.map((critic) => <li>{critic}</li>)}</ul>
        </details>

        <div class="archive">
          <Content />
        </div>
      </article>

      <aside class="seance-wrapper">
        <Seance
          endpoint={`/api/exhibits/${exhibit.id}/seance`}
          ghost={data.ghost}
          catchphrase={data.catchphrase}
          color={data.color}
          showGhost={false}
          talkingGhost="[data-portrait]"
        />
      </aside>
    </div>

    <div class="visitors">
      <Offering exhibitId={exhibit.id} offering={data.offering} color={data.color} />
      <Guestbook exhibitId={exhibit.id} ghost={data.ghost} color={data.color} />
    </div>
  </div>
</Museum>

<style>
  .exhibit {
    display: grid;
    gap: 32px;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    /* Each column keeps its own height: the séance stays at the top and does not follow the scroll. */
    align-items: start;
  }

  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back:hover {
    color: var(--ghost);
  }

  .portrait {
    display: grid;
    place-items: center;
    height: 200px;
    border-radius: var(--radius);
    background: radial-gradient(circle at 50% 60%, color-mix(in srgb, var(--ghost) 22%, transparent), transparent 70%),
      var(--surface);
    margin-bottom: 20px;
  }

  h1 {
    margin: 4px 0;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.1;
  }

  .epitaph {
    color: var(--ghost);
    font-style: italic;
    font-size: 1.1rem;
  }

  .critics {
    margin-block: 20px;
    padding: 12px 16px;
    border: 1px dashed var(--border);
    border-radius: 12px;
  }

  .critics summary {
    cursor: pointer;
    font-weight: 700;
  }

  .critics ul {
    margin: 10px 0 0;
    padding-left: 20px;
    color: var(--muted);
  }

  .archive :global(h2) {
    font-size: 1rem;
    margin: 28px 0 6px;
    color: var(--ghost);
    font-family: var(--font-code);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .archive :global(p) {
    margin: 0 0 12px;
    color: var(--text);
    opacity: 0.88;
  }

  .visitors {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 820px) {
    .top {
      grid-template-columns: 1fr;
    }

    .visitors {
      grid-template-columns: 1fr;
    }
  }
</style>