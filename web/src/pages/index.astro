---
import { getCollection } from "astro:content";
import Museum from "../layouts/Museum.astro";
import ExhibitCard from "../components/ExhibitCard.astro";

const exhibits = (await getCollection("exhibits")).sort((a, b) => a.data.order - b.data.order);
---

<Museum title="Haunted Museum of Dead Tech">
  <section class="hero container">
    <p class="eyebrow">Open every night · Halloween & Día de los Muertos</p>
    <h1>The technologies we buried <span>still have something to say.</span></h1>
    <p class="intro">
      Walk through the halls, choose an exhibit and hold a séance. Each ghost tells its story,
      answers its critics and argues why it deserves to come back.
    </p>
  </section>

  <section class="container wings">
    <a href="/debate" class="wing">
      <span class="wing-emoji">⚔️</span>
      <span>
        <strong>Debate Hall</strong>
        <small>Two ghosts argue live about who deserves to come back. You pick the winner.</small>
      </span>
    </a>
    <a href="/graveyard" class="wing">
      <span class="wing-emoji">🪦</span>
      <span>
        <strong>Repo Graveyard</strong>
        <small>Your abandoned GitHub projects get a tombstone, an epitaph and a ghost.</small>
      </span>
    </a>
  </section>

  <section class="container">
    <p class="eyebrow">Historical wing · {exhibits.length} exhibits</p>
    <div class="grid">
      {
        exhibits.map((exhibit) => (
          <ExhibitCard
            id={exhibit.id}
            name={exhibit.data.name}
            born={exhibit.data.born}
            died={exhibit.data.died}
            color={exhibit.data.color}
            epitaph={exhibit.data.epitaph}
          />
        ))
      }
    </div>
  </section>
</Museum>

<script>
  import { getJson } from "../lib/api";

  type Scores = Record<string, { wins: number; losses: number }>;

  // Offerings and debate wins come from the museum server, so they are loaded in the browser.
  Promise.all([
    getJson<Record<string, number>>("/api/offerings").catch(() => ({}) as Record<string, number>),
    getJson<Scores>("/api/debate/scoreboard").catch(() => ({}) as Scores),
  ]).then(([offerings, scores]) => {
    document.querySelectorAll<HTMLElement>("[data-stats-for]").forEach((el) => {
      const id = el.dataset.statsFor!;
      const parts = [`🕯️ ${offerings[id] ?? 0}`];
      if (scores[id]) parts.push(`⚔️ ${scores[id].wins}W`);
      el.textContent = parts.join("  ");
    });

    const [mostLoved, count] = Object.entries(offerings).sort((a, b) => b[1] - a[1])[0] ?? [];
    if (mostLoved && count > 0) {
      document.querySelector<HTMLElement>(`[data-badge-for="${mostLoved}"]`)?.removeAttribute("hidden");
    }
  });
</script>

<style>
  .wings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .wing {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: linear-gradient(135deg, var(--surface), var(--surface-2));
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .wing:hover {
    transform: translateY(-3px);
    border-color: var(--lavender);
  }

  .wing-emoji {
    font-size: 2rem;
  }

  .wing strong {
    display: block;
    font-size: 1.1rem;
  }

  .wing small {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .hero {
    padding-block: 48px 40px;
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  h1 {
    margin: 12px 0 16px;
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1.1;
    font-weight: 800;
  }

  h1 span {
    color: var(--lavender);
  }

  .intro {
    color: var(--muted);
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    margin-top: 12px;
  }
</style>
