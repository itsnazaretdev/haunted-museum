---
interface Props {
  color: string;
  size?: number;
  mood?: "calm" | "talking";
}

const { color, size = 96, mood = "calm" } = Astro.props;
---

<svg
  class:list={["ghost", mood]}
  width={size}
  height={size * 1.2}
  viewBox="0 0 100 120"
  aria-hidden="true"
  style={`--ghost: ${color}`}
>
  <path
    class="body"
    d="M50 8C25 8 14 28 14 50v58l12-10 12 10 12-10 12 10 12-10 12 10V50C86 28 75 8 50 8Z"
  ></path>
  <ellipse class="eye" cx="38" cy="50" rx="5" ry="7"></ellipse>
  <ellipse class="eye" cx="62" cy="50" rx="5" ry="7"></ellipse>
  <circle class="blush" cx="30" cy="62" r="5"></circle>
  <circle class="blush" cx="70" cy="62" r="5"></circle>
  <ellipse class="mouth" cx="50" cy="68" rx="5" ry="4"></ellipse>
</svg>

<style>
  .ghost {
    overflow: visible;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--ghost) 45%, transparent));
    animation: float 4s ease-in-out infinite;
  }

  .body {
    fill: var(--ghost);
    opacity: 0.92;
  }

  .eye,
  .mouth {
    fill: #2a2238;
  }

  .blush {
    fill: #ff8fab;
    opacity: 0.35;
  }

  .eye {
    animation: blink 6s infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  .talking .mouth {
    animation: talk 0.35s ease-in-out infinite alternate;
    transform-origin: center;
    transform-box: fill-box;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes blink {
    0%, 94%, 100% { transform: scaleY(1); }
    97% { transform: scaleY(0.1); }
  }

  @keyframes talk {
    from { transform: scaleY(0.4); }
    to { transform: scaleY(1.3); }
  }
</style>
